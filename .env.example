# ===================================================
# Samar AgriRescue - Environment Variables Example
# ===================================================

# Environment & Server
NODE_ENV=production
PORT=5000
BASE_PATH=/

# Session & Security
SESSION_SECRET=samar-agrirescue-development-secret
LOG_LEVEL=info

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Database (Neon PostgreSQL or Supabase connection string)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Domain Branding & URLs
DOMAIN=SamarAgriRescue.com
PUBLIC_URL=https://SamarAgriRescue.com
VITE_API_BASE_URL=/
