# ===================================================
# Samar AgriRescue - Environment Variables Example
# ===================================================

# Environment & Server
NODE_ENV=production
PORT=5000
BASE_PATH=/

# Session & Security
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-hex-string
LOG_LEVEL=info

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional: must be a public HTTPS URL registered in Google Cloud Console.
# Leave unset to derive the callback from the request host (works for localhost and tunnels).
# GOOGLE_REDIRECT_URI=https://SamarAgriRescue.com/api/auth/google/callback

# Database (Neon PostgreSQL or Supabase connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Domain Branding & URLs
DOMAIN=SamarAgriRescue.com
PUBLIC_URL=https://SamarAgriRescue.com
VITE_API_BASE_URL=/
